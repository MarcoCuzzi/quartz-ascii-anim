{
  "name": "quartz-ascii-anim",
  "version": "0.1.0",
  "description": "Animazioni ASCII per Quartz v5",
  "type": "module",
  "license": "MIT",
  "author": "MarcoCuzzi",
  "homepage": "https://github.com/MarcoCuzzi/quartz-ascii-anim",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcoCuzzi/quartz-ascii-anim"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "ascii",
    "animation"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    },
    "vfile": {
      "optional": true
    }
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "preact": "^10.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vfile": "^6.0.3"
  },
  "quartz": {
    "name": "ascii-anim",
    "displayName": "ASCII Animations",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "fpsMin": 1,
      "fpsMax": 30,
      "fpsDefault": 4,
      "maxFrames": 100
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}